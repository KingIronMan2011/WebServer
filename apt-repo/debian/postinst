#!/bin/sh
set -eu

if ! getent group www-data >/dev/null 2>&1; then groupadd --system www-data; fi
if ! getent passwd www-data >/dev/null 2>&1; then useradd --system --gid www-data --home-dir /var/www --shell /usr/sbin/nologin www-data; fi
install -d -m 0750 -o root -g www-data /etc/webserver/sites /etc/webserver/certificates/local
install -d -m 0750 -o www-data -g www-data /etc/webserver/certificates/acme /var/www/webserver/public /var/log/webserver
if [ ! -f /etc/webserver/webserver.toml ]; then install -m 0640 -o root -g www-data /usr/share/webserver/webserver.toml /etc/webserver/webserver.toml; fi
if [ ! -f /etc/webserver/sites/localhost.conf ]; then install -m 0640 -o root -g www-data /usr/share/webserver/localhost.conf /etc/webserver/sites/localhost.conf; fi
if [ ! -f /var/www/webserver/public/index.html ]; then printf '%s\n' '<!doctype html><title>Webserver</title><h1>It works!</h1>' > /var/www/webserver/public/index.html; chown www-data:www-data /var/www/webserver/public/index.html; fi
if command -v systemctl >/dev/null 2>&1; then systemctl daemon-reload || true; fi
