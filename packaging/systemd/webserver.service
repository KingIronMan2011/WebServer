[Unit]
Description=Webserver reverse proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/webserver
Environment=WEBSERVER_LOG_FORMAT=json
# Optional: configure OTEL_EXPORTER_OTLP_ENDPOINT in a systemd drop-in.
ExecStart=/usr/local/bin/webserver run --config /etc/webserver/webserver.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3s

# Allow a non-root service user to bind to ports 80 and 443 once configured.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectClock=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
UMask=0027
ReadWritePaths=/var/www/webserver /var/log/webserver /var/lib/webserver /etc/webserver/sites /etc/webserver/certificates/acme

[Install]
WantedBy=multi-user.target
